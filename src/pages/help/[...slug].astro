---
import Layout from '../../layouts/SiteLayout.astro';
import HelpSidebar from '../../components/HelpSidebar.astro';
import docs from '../../data/help.json';
export function getStaticPaths(){return docs.map(doc=>({params:{slug:doc.slug},props:{doc}}));}
const {doc}=Astro.props;
const related=docs.filter(d=>d.group===doc.group&&d.slug!==doc.slug);
---
<Layout title={`${doc.title}：使用指南`} description={`译想${doc.title}帮助。${doc.description}查看操作步骤、注意事项及相关使用文档。`}>
<section class="container page-hero"><p class="eyebrow">帮助中心 / {doc.group}</p><h1>{doc.title}</h1><p class="doc-lead">{doc.description}</p></section><div class="container help-layout"><HelpSidebar/><article class="prose"><h2>操作与说明</h2><ol class="doc-steps">{doc.steps.map(step=><li>{step}</li>)}</ol>{doc.slug.includes('xiazaianzhuang')&&<a class="button" href="/download/">查看版本与下载状态 →</a>}{doc.slug.includes('taocangoumai')&&<a class="text-link" href="/price/">查看官网参考价格 →</a>}<div class="notice"><strong>版本说明</strong><p>界面和功能以当前版本为准。请使用自己的或已授权的账号，遵守平台规则。</p></div>{related.length>0&&<><h2>相关指南</h2><ul>{related.map(d=><li><a href={`/help/${d.slug}/`}>{d.title}</a></li>)}</ul></>}<div class="doc-footer"><a href="/help/">← 返回帮助中心</a><a href="/contact/">还需要帮助？联系我们 →</a></div></article></div>
</Layout>
