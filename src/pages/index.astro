---
import Layout from '../layouts/SiteLayout.astro';
import { featurePages } from '../data/features';
import { homePlans } from '../data/pricing';
import ProductVideo from '../components/ProductVideo.astro';
import { videos } from '../config/videos';
---
<Layout title="译想外贸跨境电商聊天自动翻译软件" description="译想为外贸与跨境电商提供聊天实时翻译、语音翻译、多引擎选择、快捷回复和客户跟进功能。支持 Windows 和 macOS，注册即送3万积分。">
  <section class="home-banner">
    <div class="container banner-inner">
      <div class="banner-copy"><p class="eyebrow">译想 · 社交软件实时翻译</p><h1>译想外贸跨境电商<br/>聊天自动翻译软件</h1><p class="banner-description">收到外语消息，用中文回复。<br/>不用复制粘贴，不用切换应用。</p><div class="actions"><a class="button" href="/help/#download">软件下载</a><a class="button secondary" href="#demo">查看演示 <span aria-hidden="true">▶</span></a></div><p class="banner-note">Windows / macOS · 注册即送 3 万积分</p></div>
      <div class="banner-picture"><img src="/images/chatefect.png" alt="译想聊天窗口中外语消息与中文译文对照" width="906" height="525" fetchpriority="high"/></div>
    </div>
  </section>
  <section class="section product-showcase" id="demo"><div class="container"><div class="section-heading"><h2>产品展示</h2><p>Product Display</p></div><div class="demo-frame"><ProductVideo id={videos.overview.id} title={videos.overview.title} autoplay/></div></div></section>
  <section class="section tinted"><div class="container"><div class="section-heading"><h2>产品特色</h2><p>Product Features</p></div><div class="feature-card-grid">{featurePages.map(feature => <a class="feature-card" href={feature.href}><img src={`/images/${feature.icon}`} alt="" width="46" height="46" loading="lazy"/><div><h3>{feature.title}</h3><p>{feature.summary}</p></div><span class="feature-arrow" aria-hidden="true">→</span></a>)}</div></div></section>
  <section class="section home-packages"><div class="container"><div class="section-heading"><h2>价格方案</h2><p>Pricing Plans</p></div><div class="home-plan-grid">{homePlans.map((plan,index) => <article class:list={['home-plan',`home-plan-${index}`]}><h3>{plan.name}</h3><p class="plan-amount"><span>¥</span>{plan.price}<small>{plan.unit}</small></p><p class="plan-short">{index===0?'注册赠送 3 万积分':index===1?'用多少扣多少':'按月使用，不自动续费'}</p><ul><li>{index===2?'翻译引擎因版本而异':'聊天翻译与快捷回复'}</li><li>{index===2?'不限翻译字符数量':'未读提醒与客户档案'}</li></ul><a class="button secondary" href={index===0?'/help/#download':'/price/'}>{index===0?'免费体验':'查看方案'}</a></article>)}</div></div></section>
  <section class="support-strip"><div class="container"><div><h2>边聊边译，畅聊全球</h2><p>产品和套餐问题，欢迎联系客服。</p></div><a class="button" href="/help/#contact">联系我们</a></div></section>
</Layout>
