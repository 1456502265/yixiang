---
import Layout from '../layouts/SiteLayout.astro';
import Features from '../components/Features.astro';
import Platforms from '../components/Platforms.astro';
import Pricing from '../components/Pricing.astro';
import { engines, scenarios } from '../data/product';
import ProductVideo from '../components/ProductVideo.astro';
import { videos } from '../config/videos';
---
<Layout title="社交软件实时翻译，边聊边译，畅聊全球" description="译想（原 TransQuickly）为外贸、跨境电商和跨国团队提供聊天翻译、语音翻译与快捷回复。了解产品、价格、客户端下载与使用帮助。">
<section class="hero"><div class="container hero-grid"><div><p class="eyebrow"><span class="status-dot"></span> 译想 · 译你所想</p><h1>译想外贸跨境电商聊天自动翻译软件</h1><p class="hero-description">收到外语消息，<br/>用中文回复。</p><p class="hero-detail">在 WhatsApp、Telegram、Line 等 20+ 社交软件中，<br class="desktop-break"/>收到消息自动翻译，中文回复自动翻译成外语。</p><div class="actions"><a class="button" href="/download/">软件下载 <span aria-hidden="true">↗</span></a><a class="text-link" href="#product-demo">1 分钟看效果 <span aria-hidden="true">▶</span></a></div><p class="fine">支持 Windows / macOS · 支持 200 多种语言 · 注册即送 3 万积分</p></div><div class="hero-visual"><div class="visual-label"><span class="status-dot"></span> 聊天翻译效果</div><img src="/images/chatefect.png" alt="译想聊天翻译界面示例：外语消息下方显示中文译文，中文回复可翻译成外语" width="906" height="525" fetchpriority="high"/><div class="visual-caption"><span>你好，世界。</span><span>Hello, world. <span aria-hidden="true">↗</span></span></div></div></div><div class="container hero-bottom"><span>社交软件实时翻译</span><span>外贸询盘 <i>/</i> 客户服务 <i>/</i> 跨国协作</span><a href="#how">查看功能 ↓</a></div></section>
<section class="section soft" id="product-demo"><div class="container"><div class="section-heading center"><h2>1 分钟看效果</h2><p>边聊边译，畅聊全球</p></div><ProductVideo id={videos.overview.id} title={videos.overview.title}/></div></section>
<section class="section container" id="how"><div class="section-heading"><p class="eyebrow">边聊边译</p><h2>不用复制粘贴，<br/>不用切换应用。</h2><p>在聊天窗口里直接翻译，收到外语消息，用中文回复。</p></div><div class="three-grid problems">{[['waimaoxunpan.png','外贸询盘','客户发来外语询盘，自动翻译成中文，直接回复。'],['kuaguoshejiao.png','跨国社交','和外国朋友聊天，不用再复制粘贴翻译。'],['yuyingxiaoxi.png','语音消息','客户发来外语语音，转成文字并翻译。']].map(([img,title,text])=><article><img src={`/images/${img}`} alt={`${title}场景示意`} width="378" height="332" loading="lazy"/><h3>{title}</h3><p>{text}</p></article>)}</div><div class="video-steps">{videos.steps.map((video, index) => <div class="video-step"><ProductVideo id={video.id} title={video.title}/><div><p class="eyebrow">Step {index + 1}</p><h3>{video.title}</h3><p>{video.description}</p></div></div>)}</div></section>
<section class="section soft"><div class="container"><div class="section-heading row-heading"><div><p class="eyebrow">不止翻译</p><h2>不止翻译，<br/>更是完整的沟通工具。</h2></div><a class="text-link" href="/product/">查看全部功能 ↗</a></div><Features/></div></section>
<section class="section container"><div class="section-heading center"><p class="eyebrow">7 种翻译引擎</p><h2>一个软件，多种翻译引擎。</h2><p>不同引擎适合不同场景，按需切换。</p></div><div class="engine-row">{engines.map(([name,img])=><div><img src={`/images/${img}`} alt="" width="44" height="44" loading="lazy"/><span>{name}</span></div>)}</div><div class="engine-note"><strong>商务沟通、日常交流、中文互译</strong><p>支持 ChatGPT、DeepSeek、DeepL、谷歌、百度、有道、火山。可用引擎以套餐为准，重要内容请人工核对。</p><a class="text-link" href="/help/liaotianfanyi/gezhongfanyiyinqingdetedian/">了解如何选择引擎 →</a></div></section>
<section class="section soft"><div class="container"><div class="section-heading"><p class="eyebrow">适用场景</p><h2>外贸、社交、学习，<br/>总有一个场景适合你。</h2></div><div class="scenario-grid">{scenarios.map(([name,text,img])=><article><img src={`/images/${img}`} alt={`${name}应用场景示意`} width="378" height="405" loading="lazy"/><div><h3>{name}</h3><p>{text}</p></div></article>)}</div></div></section>
<section class="section container"><div class="section-heading center"><p class="eyebrow">支持的社交软件</p><h2>你在哪里聊，译想就支持哪里。</h2><p>覆盖 20+ 主流社交软件，不用换平台，不用换习惯。</p></div><Platforms/><div class="center"><a class="text-link" href="/contact/">没找到你用的平台？联系我们 →</a></div></section>
<section class="section soft"><div class="container"><div class="section-heading center"><p class="eyebrow">价格方案</p><h2>简单透明的价格。</h2><p>每天都要聊客户？包月套餐更划算，不限字符，畅聊全球</p></div><Pricing/><div class="center"><a class="text-link" href="/price/#points">查看积分套餐 →</a></div></div></section>
<section class="section container trust-section"><div><p class="eyebrow">服务与支持</p><h2>安装和使用问题，<br/>随时联系我们。</h2></div><div class="trust-items"><article><span>01</span><div><h3>隐私政策</h3><p>了解个人信息和翻译内容的处理方式。</p><a href="/privacy-policy/">阅读隐私政策 →</a></div></article><article><span>02</span><div><h3>安装帮助</h3><p>选择适合系统的版本；遇到安全警告时暂停安装并核实。</p><a href="/download/">查看安装说明 →</a></div></article><article><span>03</span><div><h3>官方客服</h3><p>产品、套餐、团队采购和使用问题，都可以咨询客服。</p><a href="/contact/">联系我们 →</a></div></article></div></section>
</Layout>

<style>
.video-steps { margin-top: 48px; display: grid; gap: 44px; }
.video-step { display: grid; grid-template-columns: 1.6fr 1fr; gap: 40px; align-items: center; }
.video-step:nth-child(even) > :first-child { order: 2; }
.video-step h3 { margin-bottom: 12px; }
@media (max-width: 640px) { .video-step { grid-template-columns: 1fr; gap: 18px; } .video-step:nth-child(even) > :first-child { order: 0; } }
</style>
