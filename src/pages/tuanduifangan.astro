---
import Layout from '../layouts/SiteLayout.astro';
const questions = [
  {
    title: '员工每天浪费多少时间在“看懂客户在说什么”上？',
    description: '一个外贸业务员每天要处理几百上千条外语消息。收到新消息后，他需要先翻看之前的聊天记录，消化客户聊到哪了、什么进度、什么语气，才能准确回复。',
    without: '满屏外语，逐条复制翻译，或者凭记忆猜。一条消息平均 2-3 分钟，整个对话上下文消化更慢',
    with: '整个聊天记录都是中文，一眼扫完上下文，直接回复。每条消息 3 秒',
  },
  {
    title: '回复慢导致的丢单，一年损失多少？',
    description: '客户发来询盘，如果 1 小时内没有回复，成交率会大幅下降。翻译慢导致回复慢，客户转头就找了别家。一个丢单可能损失几千到几万，一年下来，这笔账比软件费用大得多。',
    without: '翻译慢 → 消化慢 → 回复慢 → 客户流失 → 订单损失',
    with: '整个对话中文呈现 → 秒懂上下文 → 3 秒回复 → 客户留住了 → 订单拿下了',
  },
  {
    title: '多招一个外贸业务员，成本是多少？',
    description: '一个外贸业务员的月薪加上社保、提成，成本至少在 6000-10000 元。而译想包月版每人每月 49 元，让现有员工的客户跟进能力提升 3-5 倍，相当于用不到 1% 的人力成本，获得数倍的产能。',
    without: '月薪 6000-10000 元 + 社保 + 提成 + 管理成本',
    with: '每人每月 49 元，人均跟进客户数提升 3-5 倍',
  },
];
const languages = ['英语', '阿拉伯语', '西班牙语', '葡萄牙语', '俄语', '越南语', '泰语', '法语', '德语', '日语', '韩语', '200+ 语言'];
const savedTime = [
  ['🎯', '开发新客户', '把省下的时间用来挖掘新客户', '带来增量业绩'],
  ['📈', '跟进更多询盘', '回复更快，询盘转化率更高', '订单不丢'],
  ['🌍', '研究目标市场', '把精力花在', '了解客户需求、优化产品上'],
];
const soho = [
  ['🏭', '找货、找工厂', '把省下的时间', '用来寻找更优质的供应商'],
  ['💰', '比价、谈供应链', '有更多精力', '优化成本，提升利润空间'],
  ['🌍', '拓展新市场', '一个人也能像一支团队一样', '高效运转'],
];
---
<Layout title="团队方案：让外贸业务员多跟进3-5倍客户，降本增效" description="让每个外贸业务员，多跟进3-5倍客户。整个客户对话都变成中文，一眼看懂上下文，直接回复。团队采购请联系我们获取专属方案。">
  <section class="container page-hero team-hero">
    <h1>让每个外贸业务员，<br/><span>多跟进 3-5 倍客户</span></h1>
    <p>不是翻译更快，而是整个客户对话都变成了中文。业务员一眼看懂聊到哪了，直接回复，不再被外语上下文拖慢。</p>
    <div class="three-grid team-metrics">
      <article><h2>全中文</h2><h3>整个对话都是中文</h3><p>聊天记录自动翻译，一眼扫完上下文<br/>立刻知道客户聊到哪了</p></article>
      <article><h2>↑3-5倍</h2><h3>人均跟进客户数</h3><p>不再被外语上下文拖慢<br/>一个员工顶过去三五个</p></article>
      <article><h2>¥49</h2><h3>每人每月成本</h3><p>不到多招一个人力的 1%<br/>效率提升数倍</p></article>
    </div>
  </section>

  <section class="section soft">
    <div class="container">
      <div class="section-heading center"><h2>老板最关心的三个问题</h2></div>
      <ol class="boss-questions">
        {questions.map(question => (
          <li>
            <h3>{question.title}</h3>
            <p>{question.description}</p>
            <div class="boss-compare">
              <div class="without"><strong>没有译想</strong><p>{question.without}</p></div>
              <div class="with"><strong>使用译想</strong><p>{question.with}</p></div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section container">
    <div class="section-heading center"><h2>不懂外语，也能做外贸</h2></div>
    <div class="prose team-copy">
      <p>做外贸，客户来自全球各地。阿拉伯语、西班牙语、葡萄牙语、俄语、越南语……一个业务员不可能懂所有语言。就算懂英语，面对只说阿拉伯语的客户，也只能干瞪眼。</p>
      <p>译想让业务员用中文跟任何国家的客户聊天。客户说什么语言，译想自动翻译成中文；业务员用中文回复，译想自动翻译成客户的语言。</p>
      <p class="emphasis">不懂外语，也能做外贸。</p>
      <p>更重要的是，<strong>整个聊天记录都是中文</strong>。业务员随时打开对话，一眼就能看到之前聊了什么、聊到哪了、客户什么态度。不用翻记忆，不用重新翻译，不会因为遗忘而说错话、报错价、漏跟进。</p>
      <p>一个业务员，可以同时跟进英语、阿拉伯语、西班牙语、俄语客户，语言不再是限制。</p>
    </div>
    <div class="language-tags">{languages.map(language => <span>{language}</span>)}</div>
  </section>

  <section class="section soft">
    <div class="container center">
      <div class="section-heading"><h2>算一笔简单的账</h2></div>
      <div class="cost-compare">
        <article><h3>多招一个业务员</h3><p>¥6000+ / 月</p></article>
        <strong class="versus">VS</strong>
        <article class="with"><h3>给现有员工装译想</h3><p>¥49 / 月 / 人</p></article>
      </div>
      <p class="cost-summary">用<strong>不到 1% 的人力成本</strong>，让现有员工的客户跟进能力提升 <strong>3-5 倍</strong>。省下的时间，用来跟进更多客户、拿下更多订单。</p>
    </div>
  </section>

  <section class="section container">
    <div class="section-heading center"><h2>省下的时间，用来做更重要的事</h2></div>
    <div class="prose team-copy">
      <p>跟进老客户只是日常维护，<strong>开发新客户才是业绩增长的关键</strong>。</p>
      <p>译想帮业务员把每天浪费在翻译和消化上下文上的时间省下来，用来开发新客户、跟进更多询盘、研究目标市场。</p>
      <p>一个业务员每天多出 <strong>2 小时</strong>，一个月就是 <strong>40 多个小时</strong>——相当于多出整整一周的工作时间，全部用在开发客户上。</p>
    </div>
    <div class="three-grid text-cards team-cards">{savedTime.map(([icon, title, first, second]) => <article><span class="card-icon" aria-hidden="true">{icon}</span><h3>{title}</h3><p>{first}<br/>{second}</p></article>)}</div>
  </section>

  <section class="section soft">
    <div class="container">
      <div class="section-heading center"><h2>如果你是外贸SOHO</h2></div>
      <div class="prose team-copy">
        <p>你不仅要跟进客户，还要花大量时间<strong>找货、找工厂、比价、验厂</strong>。</p>
        <p>译想帮你把跟进客户的时间压缩到最少，让你有更多精力去<strong>选品、谈供应链、拓展新市场</strong>。</p>
        <p>一个人，也能像一支团队一样高效运转。</p>
      </div>
      <div class="three-grid text-cards team-cards">{soho.map(([icon, title, first, second]) => <article><span class="card-icon" aria-hidden="true">{icon}</span><h3>{title}</h3><p>{first}<br/>{second}</p></article>)}</div>
    </div>
  </section>

  <section class="section container center team-purchase">
    <h2>给团队装上译想，让每个员工多跟进 3-5 倍客户</h2>
    <p>免费试用，注册即送 3 万积分</p>
    <p>团队采购请联系我们获取专属方案</p>
    <a class="button" href="/contact/">联系我们</a>
  </section>
</Layout>

<style>
  .team-hero > p { max-width: 880px; }
  .team-metrics { margin-top: 48px; text-align: center; }
  .team-metrics article { padding: 30px 20px; border: 1px solid var(--line); border-radius: 12px; background: white; }
  .team-metrics h2 { color: var(--blue); font-size: 40px; margin-bottom: 12px; }
  .team-metrics h3 { font-size: 18px; margin-bottom: 12px; }
  .team-metrics p { font-size: 14px; }
  .boss-questions { list-style: none; margin: 0; padding: 0; counter-reset: question; }
  .boss-questions > li { counter-increment: question; padding: 35px 0; border-bottom: 1px solid var(--line); }
  .boss-questions > li:first-child { padding-top: 0; }
  .boss-questions > li:last-child { border-bottom: 0; padding-bottom: 0; }
  .boss-questions h3 { margin-bottom: 18px; }
  .boss-questions h3:before { content: counter(question) ". "; color: var(--blue); }
  .boss-compare { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 22px; }
  .boss-compare > div { border-radius: 10px; padding: 22px; background: #f0f2f4; }
  .boss-compare strong { display: block; margin-bottom: 10px; }
  .boss-compare p { font-size: 14px; }
  .boss-compare .with, .cost-compare .with { background: #e9f5ff; border: 1px solid #c8e4fa; }
  .with strong, .with h3 { color: var(--blue); }
  .team-copy { max-width: 980px; margin-inline: auto; }
  .team-copy .emphasis { color: var(--blue); font-weight: 700; }
  .language-tags { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 32px; }
  .language-tags span { padding: 6px 16px; border-radius: 30px; background: var(--soft); color: var(--blue); font-size: 14px; }
  .cost-compare { display: grid; grid-template-columns: 1fr 70px 1fr; align-items: center; gap: 20px; max-width: 950px; margin-inline: auto; }
  .cost-compare article { padding: 35px 20px; border: 1px solid var(--line); border-radius: 12px; background: white; }
  .cost-compare p { font-size: 32px; color: var(--blue); margin-top: 14px; font-weight: 700; }
  .versus { color: #8494a6; font-size: 24px; }
  .cost-summary { margin: 30px auto 0; max-width: 900px; }
  .cost-summary strong { color: var(--blue); }
  .team-cards { margin-top: 35px; text-align: center; }
  .card-icon { display: block; font-size: 30px; margin-bottom: 18px; }
  .team-purchase p { margin-top: 18px; }
  .team-purchase .button { margin-top: 28px; }
  @media (max-width: 640px) {
    .team-metrics h2 { font-size: 34px; }
    .boss-compare { grid-template-columns: 1fr; gap: 12px; }
    .cost-compare { grid-template-columns: 1fr; gap: 15px; }
    .cost-compare p { font-size: 28px; }
  }
</style>
