---
import '../styles/global.css';
import { site, navigation } from '../config/site';
import FloatingContact from '../components/FloatingContact.astro';
import DownloadMenu from '../components/DownloadMenu.astro';
import { featurePages } from '../data/features';
interface Props { title: string; description: string; noindex?: boolean; }
const { title, description, noindex = false } = Astro.props;
const path = Astro.url.pathname === '/404/' ? '/404.html' : Astro.url.pathname;
const canonical = new URL(path, site.url).href;
const schema = { '@context':'https://schema.org', '@graph':[
 {'@type':'Organization','@id':`${site.url}/#organization`,name:site.company,alternateName:site.name,url:site.url,logo:`${site.url}/images/logozysmall_260914.png`,email:site.email,telephone:site.phone,address:{'@type':'PostalAddress',streetAddress:site.address,addressCountry:'CN'}},
 {'@type':'WebSite','@id':`${site.url}/#website`,url:site.url,name:site.name,inLanguage:'zh-CN',publisher:{'@id':`${site.url}/#organization`}},
 {'@type':'WebPage','@id':canonical,url:canonical,name:title,description,inLanguage:'zh-CN',isPartOf:{'@id':`${site.url}/#website`}},
 ...(path==='/'?[]:[{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'首页',item:site.url+'/'},{'@type':'ListItem',position:2,name:title,item:canonical}]}]),
] };
---
<!doctype html><html lang="zh-CN"><head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<script is:inline id="google-tag-manager-init">
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  window.dataLayer.push({'gtm.start': new Date().getTime(), event: 'gtm.js'});
</script>
<script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-MP9WBHRK"></script>
<title>{title} | 译想</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>
<meta name="robots" content={noindex?'noindex, follow':'index, follow, max-image-preview:large'}/>
<meta name="theme-color" content="#017fe4"/><link rel="icon" type="image/png" href="/images/logo_bluedi2.png"/><link rel="sitemap" href="/sitemap-index.xml"/>
<meta property="og:type" content="website"/><meta property="og:locale" content="zh_CN"/><meta property="og:site_name" content="译想"/>
<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/>
<meta property="og:image" content={`${site.url}/images/homeogi.png`}/><meta property="og:image:alt" content="译想社交软件实时翻译"/>
<meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={`${site.url}/images/homeogi.png`}/>
<script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/>
</head><body>
<a class="skip-link" href="#main">跳转到正文</a>
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="译想首页"><img src="/images/logozysmall_260914.png" alt="译想" width="114" height="40" /></a>
    <nav class="desktop-nav" aria-label="主导航">
      <a href="/" aria-current={path === '/' ? 'page' : undefined}>首页</a>
      <details class="nav-features"><summary aria-current={path === '/product/' || path.startsWith('/features/') ? 'page' : undefined}>软件功能 <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></summary><div class="nav-feature-menu">{featurePages.map(feature => <a href={feature.href}>{feature.title}</a>)}</div></details>
      <a href="/price/" aria-current={path === '/price/' ? 'page' : undefined}>价格方案</a>
      <a href="/help/" aria-current={path === '/help/' ? 'page' : undefined}>帮助中心</a>
    </nav>
    <div class="header-actions"><DownloadMenu/><a class="try-link" href="/help/#download">免费试用<small>注册即送 3 万积分</small></a></div>
    <details class="mobile-nav"><summary aria-label="展开导航">菜单 ☰</summary><nav aria-label="移动端导航">{navigation.map(([href,label]) => <a href={href}>{label}</a>)}<div class="mobile-feature-links">{featurePages.map(feature => <a href={feature.href}>{feature.title}</a>)}</div><a href="/help/#download">软件下载</a></nav></details>
  </div>
</header>
<main id="main"><slot/></main>
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-intro"><a href="/" class="footer-logo"><img src="/images/logozysmall_260914.png" alt="译想" width="114" height="40"/></a><p>边聊边译，畅聊全球。</p><p class="fine">原 TransQuickly（翻译快）</p></div>
    <div><h2>软件功能</h2>{featurePages.slice(0,3).map(feature => <a href={feature.href}>{feature.title}</a>)}</div>
    <div><h2>使用与服务</h2><a href="/price/">价格方案</a><a href="/help/">帮助中心</a><a href="/help/#download">软件下载</a><a href="/user-service-agreement/">用户协议与隐私政策</a></div>
    <div><h2>联系我们</h2><a href={site.phoneHref}>{site.phone}</a><a href={`mailto:${site.email}`}>{site.email}</a><p class="fine">{site.hours}</p><div class="footer-social">{site.channels.map(channel => <a href={channel.href} target="_blank" rel="noopener noreferrer">{channel.name}</a>)}</div></div>
  </div>
  <div class="container footer-bottom">© {new Date().getFullYear()} {site.company}<span>译想</span></div>
</footer>
<FloatingContact />
</body></html>
