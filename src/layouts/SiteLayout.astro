---
import '../styles/global.css';
import { site, navigation } from '../config/site';
import FloatingContact from '../components/FloatingContact.astro';
interface Props { title: string; description: string; noindex?: boolean; }
const { title, description, noindex = false } = Astro.props;
const path = Astro.url.pathname === '/404/' ? '/404.html' : Astro.url.pathname;
const canonical = new URL(path, site.url).href;
const schema = { '@context':'https://schema.org', '@graph':[
 {'@type':'Organization','@id':`${site.url}/#organization`,name:site.company,alternateName:site.name,url:site.url,logo:`${site.url}/images/logozysmall_260914.png`,email:site.email,telephone:site.phone,address:{'@type':'PostalAddress',streetAddress:site.address,addressCountry:'CN'}},
 {'@type':'WebSite','@id':`${site.url}/#website`,url:site.url,name:site.name,inLanguage:'zh-CN',publisher:{'@id':`${site.url}/#organization`}},
 {'@type':'WebPage','@id':canonical,url:canonical,name:title,description,inLanguage:'zh-CN',isPartOf:{'@id':`${site.url}/#website`}},
 ...(path==='/'?[]:[{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'首页',item:site.url+'/'},{'@type':'ListItem',position:2,name:title,item:canonical}]}]),
] };
---
<!doctype html><html lang="zh-CN"><head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<script is:inline id="google-tag-manager-init">
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  window.dataLayer.push({'gtm.start': new Date().getTime(), event: 'gtm.js'});
</script>
<script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-MP9WBHRK"></script>
<title>{title} | 译想</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>
<meta name="robots" content={noindex?'noindex, follow':'index, follow, max-image-preview:large'}/>
<meta name="theme-color" content="#017fe4"/><link rel="icon" type="image/png" href="/images/logo_bluedi2.png"/><link rel="sitemap" href="/sitemap-index.xml"/>
<meta property="og:type" content="website"/><meta property="og:locale" content="zh_CN"/><meta property="og:site_name" content="译想"/>
<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/>
<meta property="og:image" content={`${site.url}/images/homeogi.png`}/><meta property="og:image:alt" content="译想社交软件实时翻译"/>
<meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={`${site.url}/images/homeogi.png`}/>
<script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/>
</head><body>
<a class="skip-link" href="#main">跳转到正文</a>
<div class="announcement">TransQuickly 现已更名为 <strong>译想</strong><span class="announcement-extra"> · 感谢您的访问</span></div>
<header class="site-header"><div class="container header-inner"><a href="/" class="brand" aria-label="译想首页"><img src="/images/logozysmall_260914.png" alt="译想" width="130" height="40"/></a>
<nav class="desktop-nav" aria-label="主导航">{navigation.map(([href,label])=><a href={href} aria-current={(href==='/'?path==='/':path.startsWith(href))?'page':undefined}>{label}</a>)}</nav>
<details class="mobile-nav"><summary aria-label="展开主导航">菜单 <span aria-hidden="true">☰</span></summary><nav aria-label="移动端主导航">{navigation.map(([href,label])=><a href={href} aria-current={path===href?'page':undefined}>{label}</a>)}</nav></details>
</div></header>
<main id="main">{path!=='/'&&<div class="container breadcrumb"><a href="/">首页</a><span aria-hidden="true">/</span><span>{title}</span></div>}<slot/></main>
<section class="cta-band"><div class="container cta-inner"><div><p class="eyebrow">边聊边译，畅聊全球</p><h2>收到外语消息，用中文回复。</h2><p>不用复制粘贴，不用切换应用。</p></div><a class="button white" href="/download/">软件下载 <span aria-hidden="true">↗</span></a></div></section>
<footer><div class="container footer-grid"><div><a class="footer-brand" href="/">译想<span>译你所想</span></a><p>边聊边译，畅聊全球。</p><p class="fine">原 TransQuickly（翻译快）</p></div><div><h2>产品与价格</h2><a href="/product/">产品介绍</a><a href="/tuanduifangan/">团队方案</a><a href="/price/">价格方案</a><a href="/download/">软件下载</a></div><div><h2>服务与支持</h2><a href="/help/">帮助中心</a><a href="/about/">关于我们</a><a href="/privacy-policy/">隐私政策</a><a href="/user-service-agreement/">用户服务协议</a></div><div><h2>联系我们</h2><a href={site.phoneHref}>{site.phone}</a><a href={`mailto:${site.email}`}>{site.email}</a><p class="fine">{site.hours}</p><div class="social-links">{site.channels.map(c=><a href={c.href} rel="noopener noreferrer">{c.name}</a>)}</div></div></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} {site.company}</span></div></footer>
<FloatingContact />
</body></html>
