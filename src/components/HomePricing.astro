---
import { homePlans } from '../data/pricing';
---
<div class="pricing-grid">
  {homePlans.map((plan, index) => (
    <article class:list={['plan', { featured: index === 2 }]}>
      {index === 2 && <span class="plan-badge">🔥 推荐</span>}
      <h3>{plan.name}</h3>
      <div class="price"><span>¥</span>{plan.price}{plan.unit && <small>{plan.unit}</small>}</div>
      <p>{plan.description}</p>
      <ul>{plan.features.map(feature => <li>{feature}</li>)}</ul>
      <a class:list={['button', { secondary: index !== 2 }]} href={plan.href}>{plan.action}</a>
    </article>
  ))}
</div>
<p class="fine center">免费版注册即送 3 万积分，先试用再决定。积分版和包月版支持不满意退余额。</p>
