---
import { engineNames, monthlyFeatures, monthlyPlans } from '../data/pricing';
---
<div class="pricing-grid">
        {monthlyPlans.map((plan, index) => (
          <article class:list={['plan', { featured: index === 1 }]}>
            {index === 1 && <span class="plan-badge">🔥 推荐</span>}
            <h3>{plan.name}</h3>
            <div class="price"><span>¥</span>{plan.price}<small>/ 月</small></div>
            <p>{plan.description}</p>
            <div class="engine-tags" aria-label={`${plan.name}翻译引擎`}>
              {engineNames.map(engine => (
                <span class:list={['engine-tag', { unavailable: !plan.engines.includes(engine) }]}>
                  {engine}<span class="sr-only">{plan.engines.includes(engine) ? '：支持' : '：不包含'}</span>
                </span>
              ))}
            </div>
            <ul>{monthlyFeatures.map(feature => <li>{feature}</li>)}</ul>
            <a class:list={['button', { secondary: index !== 1 }]} href="/download/">下载软件购买</a>
          </article>
        ))}
      </div>
      <p class="fine center">具体价格与购买的窗口数量、时长、账号数量有关，请以译想软件内价格为准。</p>

<style>
  .engine-tags { display: flex; flex-wrap: wrap; gap: 7px; margin: 22px 0 12px; }
  .engine-tag { background: #eaf5ff; color: var(--blue); border: 1px solid #d1e7f8; border-radius: 5px; padding: 3px 9px; font-size: 12px; }
  .engine-tag.unavailable { background: #f4f5f6; color: #88929d; border-color: #e5e8ec; text-decoration: line-through; }
  .plan .price { color: var(--blue); }
  .plan > p { min-height: 48px; }
</style>
