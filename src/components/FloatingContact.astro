---
import { site } from '../config/site';
---
<aside class="floating-contact" aria-label="在线客服">
  {site.channels.map(channel => (
    <details name="floating-contact-channel" class="contact-channel">
      <summary aria-label={`${channel.name}，点击查看二维码和联系方式`}>
        <img src={channel.icon} alt="" width="28" height="28" />
        <span class="channel-name">{channel.name}</span>
      </summary>
      <div class="contact-panel">
        <h2>{channel.name}</h2>
        <p>{channel.label}</p>
        <img class="contact-qr" src={channel.qr} alt={`${channel.name}客服二维码`} width="192" height="192" loading="lazy" />
        <a class="contact-action" href={channel.href} target="_blank" rel="noopener noreferrer">
          {channel.name === '微信客服' ? '查看大图' : `打开 ${channel.name}`}<span aria-hidden="true"> ↗</span>
        </a>
      </div>
    </details>
  ))}
  <a class="all-contacts" href="/contact/">联系我们<span aria-hidden="true"> ↗</span></a>
</aside>

<style>
  .floating-contact {
    position: fixed;
    z-index: 40;
    top: 50%;
    right: 16px;
    transform: translateY(-50%);
    width: 82px;
    padding: 5px;
    border: 1px solid #d8e7f3;
    border-radius: 12px;
    background: white;
    box-shadow: 0 6px 28px #153f641a;
  }
  .contact-channel > summary {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    min-height: 78px;
    padding: 10px 2px;
    border-radius: 7px;
    color: #415973;
    cursor: pointer;
    list-style: none;
    font-size: 10px;
    line-height: 1.5;
  }
  .contact-channel > summary::-webkit-details-marker { display: none; }
  .contact-channel > summary img { width: 28px; height: 28px; object-fit: contain; }
  .contact-channel > summary:hover,
  .contact-channel[open] > summary { color: var(--blue); background: #edf7ff; }
  .contact-panel {
    position: absolute;
    top: 50%;
    right: calc(100% + 12px);
    transform: translateY(-50%);
    width: min(264px, calc(100vw - 120px));
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
    padding: 22px;
    border: 1px solid #d8e7f3;
    border-radius: 12px;
    background: white;
    box-shadow: 0 8px 32px #153f641f;
    text-align: center;
  }
  .contact-panel h2 { font-size: 19px; letter-spacing: 0; }
  .contact-panel p { margin-top: 8px; font-size: 12px; overflow-wrap: anywhere; }
  .contact-panel .contact-qr { width: 192px; height: 192px; object-fit: contain; margin: 16px auto; }
  .contact-action { display: block; padding: 9px 12px; background: var(--blue); color: white; border-radius: 6px; font-size: 13px; }
  .contact-action:hover { background: var(--blue-dark); color: white; }
  .all-contacts { display: block; padding: 10px 0 6px; border-top: 1px solid var(--line); text-align: center; font-size: 11px; color: var(--blue); }
  @media (max-width: 640px) {
    .floating-contact {
      top: auto;
      right: 12px;
      bottom: max(12px, env(safe-area-inset-bottom));
      transform: none;
      display: flex;
      align-items: center;
      width: auto;
      padding: 4px;
      border-radius: 10px;
    }
    .contact-channel > summary { width: 46px; min-height: 46px; padding: 8px; }
    .channel-name { display: none; }
    .contact-panel { top: auto; bottom: calc(100% + 12px); right: 0; transform: none; width: min(264px, calc(100vw - 24px)); max-height: calc(100dvh - 94px); }
    .all-contacts { display: flex; align-items: center; min-height: 44px; padding: 0 10px; margin-left: 4px; border-top: 0; border-left: 1px solid var(--line); }
  }
</style>
