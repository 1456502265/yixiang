---
interface Props { system: 'windows' | 'apple'; }
const { system } = Astro.props;
---
<svg class="system-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="48" height="48" fill="currentColor" aria-hidden="true" focusable="false">
  {system === 'windows' ? (
    <path d="M1 3.4 10 2.2v9.1H1zm10-1.35L23 .4v10.9H11zM1 12.3h9v9.1L1 20.15zm10 0h12v11.3l-12-1.65z" />
  ) : (
    <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.64.72 3.39 1.8-3.1 1.86-2.36 5.95.48 7.1-.57 1.5-1.31 2.99-2.53 4.12zM12.03 7.25C11.88 5.02 13.69 3.18 15.77 3c.29 2.58-2.34 4.5-3.74 4.25z" />
  )}
</svg>
<style>
  .system-icon { display: block; width: 48px; height: 48px; margin: 0 auto 15px; color: var(--blue); }
</style>
