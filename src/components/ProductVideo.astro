---
import { videos } from '../config/videos';
interface Props { id: string; title: string; autoplay?: boolean; }
const { id, title, autoplay = false } = Astro.props;
const video = [videos.overview, ...videos.steps].find(video => video.id === id);
if (!video) throw new Error(`Unknown product video: ${id}`);
---
<div class="product-video">
  <video controls playsinline autoplay={autoplay} muted={autoplay} preload={autoplay ? 'auto' : 'none'} poster={video.poster} width={video.width} height={video.height} aria-label={title}>
    <source src={video.src} type="video/mp4" />
    你的浏览器不支持视频播放，可<a href={video.src}>打开视频</a>观看。
  </video>
</div>
<style>
  .product-video { width: 100%; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; background: #101820; }
  video { display: block; width: 100%; height: auto; }
</style>
